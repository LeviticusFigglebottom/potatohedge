# ─── Required ──────────────────────────────────────────────────────────────

# Postgres (Railway plugin DATABASE_URL works out of the box)
DATABASE_URL=postgres://user:pass@host:5432/db

# Anthropic API key (used to normalize AI briefing text into a strict trade schema)
ANTHROPIC_API_KEY=sk-ant-...

# Alpaca (use paper endpoints first!)
ALPACA_KEY_ID=...
ALPACA_SECRET_KEY=...
ALPACA_TRADING_BASE=https://paper-api.alpaca.markets
ALPACA_DATA_BASE=https://data.alpaca.markets

# Source for the AI briefing JSON.
# Default: call the dashboard's /api/ai/briefing endpoint over HTTPS.
# (Vercel's 60s cap is fine on the responder side because the dashboard
# already keeps the briefing under 60s; the worker has no caller-side limit.)
BRIEFING_URL=https://your-dashboard.vercel.app/api/ai/briefing

# ─── Risk knobs ────────────────────────────────────────────────────────────

# Target allocation per option position, as a fraction of portfolio value.
TARGET_ALLOC_PCT=0.10
# Hard cap on concurrent open option positions.
MAX_CONCURRENT_POSITIONS=10
# Hard cap on positions per directional bucket (bullish / bearish / neutral).
MAX_PER_DIRECTION=5
# Auto-close any short leg that is ITM with DTE <= this value.
ASSIGNMENT_CLOSE_DTE=2

# ─── Optional ──────────────────────────────────────────────────────────────

# Skip live trading (logs intended orders only). Set to "false" to arm.
DRY_RUN=true
# Override the cron schedule. Default = top of every hour, weekdays, US RTH-ish in UTC.
TICK_CRON=0 14-20 * * 1-5
# Optional Slack/Discord webhook for run summaries + errors.
ALERT_WEBHOOK_URL=
# Override the timezone the worker uses for market-hours checks.
MARKET_TZ=America/New_York
# HTTP server port (Railway sets PORT automatically).
PORT=8080
